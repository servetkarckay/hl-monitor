# ============================================================
#  hl-monitor configuration
# ============================================================
#  HOW TO USE THIS FILE:
#
#  1. Copy this file and name the copy ".env"   (exactly .env, nothing else)
#        cp .env.example .env
#  2. Open ".env" with any text editor and fill in the values
#     described below.
#  3. The ".env" file is in .gitignore. It will NEVER be uploaded
#     to GitHub by git. Never rename it or commit it yourself.
# ============================================================


# ------------------------------------------------------------
# NETWORK
# ------------------------------------------------------------
# Which Hyperliquid network to talk to.
# You almost certainly want: mainnet
# (use "testnet" only if you deliberately trade on Hyperliquid Testnet)
NETWORK=mainnet

# ------------------------------------------------------------
# HYPERLIQUID_API_URL / HYPERLIQUID_WS_URL
# ------------------------------------------------------------
# Where the monitor reads its data from.
# Leave these EXACTLY as they are below unless Hyperliquid changes
# their API endpoints. They are the official public endpoints.
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# ------------------------------------------------------------
# USER_ADDRESS   (REQUIRED - this is the account the monitor shows)
# ------------------------------------------------------------
# This is YOUR wallet address on Hyperliquid - the 0x... address
# you see when you open hyperliquid.xyz.
#
# HOW TO FIND IT:
#   1. Go to https://app.hyperliquid.xyz
#   2. Connect / log in with your wallet
#   3. Click your address in the top-right corner and copy it
#      (or open "Account" and copy the address shown there)
#   4. Paste it below.
#
# It looks like: 0x1a2b3c4d5e6f... (42 characters, starts with 0x)
#
# The monitor only READS public account data for this address.
# Anyone can read it - there is nothing secret about this value.
USER_ADDRESS=0x0000000000000000000000000000000000000000

# ------------------------------------------------------------
# API_WALLET_ADDRESS   (OPTIONAL - you can usually ignore this)
# ------------------------------------------------------------
# Only fill this in if you trade on Hyperliquid through an
# "API wallet" (agent wallet) instead of your main wallet.
# If you don't know what that is, leave the placeholder as is.
API_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# ------------------------------------------------------------
# HYPERLIQUID_PRIVATE_KEY   (IMPORTANT - READ THIS)
# ------------------------------------------------------------
# *** Do NOT put your real trading wallet's private key here. ***
#
# This monitor is READ-ONLY. It can never place, modify or cancel
# orders. It does not need a "real" key at all: it only needs any
# valid 32-byte hex key to build its HTTP client.
#
# The value below is a well-known PUBLIC test key (Ethereum's
# Hardhat account #0). It controls no funds and is safe to use
# for monitoring. You can simply keep it.
#
# If you prefer your own key, generate a random one:
#   python3 -c "import os,secrets; print(secrets.token_hex(32))"
# and paste the output below. It still will not give the monitor
# any trading ability.
HYPERLIQUID_PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
